# frozen_string_literal: true

# The Rails floor the README claims. The root Gemfile is deliberately unpinned, so
# it always resolves the newest Rails and nothing else proves 7.1 still boots --
# which matters because the railtie reads `routes.default_url_options` and reaches
# Action Mailer through `ActiveSupport.on_load`, both of which are Rails internals.
source "https://rubygems.org"

gemspec path: ".."

gem "rake", "~> 13.0"
gem "minitest", "~> 5.25"

gem "railties", "~> 7.1.0"
gem "actionmailer", "~> 7.1.0"
# Pinned here for the same reason: the database rename reaches into
# ActiveRecord::DatabaseConfigurations and calls `_database=`, which is `:nodoc:`.
gem "activerecord", "~> 7.1.0"

gem "foreman", ">= 0.90.0"

# The zeroconf naming mode's optional dependency; see the root Gemfile.
gem "zeroconf", ">= 1.2.0"
